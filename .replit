modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NOVALUTH_EMAIL_FROM = "contact@novaluth.com"
NOVALUTH_PUBLIC_URL = "https://novaluth.replit.app/"
NOVALUTH_SN13_ALERT_EMAIL = "contact@novaluth.com"
