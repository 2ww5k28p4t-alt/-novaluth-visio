modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "db-schema"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "meet-auth"

[[workflows.workflow]]
name = "db-schema"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/db run check-schema:wiring && pnpm --filter @workspace/db run check-schema:isolated"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "meet-auth"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test:meet-auth"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NOVALUTH_EMAIL_FROM = "contact@novaluth.com"
NOVALUTH_PUBLIC_URL = "https://novaluth.replit.app/"
NOVALUTH_SN13_ALERT_EMAIL = "contact@novaluth.com"
