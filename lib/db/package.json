{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "pnpm run check-schema:before-push && drizzle-kit push --config ./drizzle.config.ts && pnpm run install:prospection-journal-guard && pnpm run check-schema",
    "push-force": "bash ./scripts/push-schema-isolated.sh",
    "check-schema": "../../scripts/node_modules/.bin/tsx ./src/schema-check.ts",
    "check-schema:before-push": "../../scripts/node_modules/.bin/tsx ./src/schema-check.ts --before-push",
    "check-schema:orphans": "../../scripts/node_modules/.bin/tsx ./src/schema-check.ts --orphans",
    "check-schema:wiring": "bash ../../scripts/check-schema-wiring.sh",
    "check-schema:isolated": "bash ./scripts/check-schema-isolated.sh",
    "install:prospection-journal-guard": "../../scripts/node_modules/.bin/tsx ./src/install-prospection-journal-guard.ts",
    "test": "../../scripts/node_modules/.bin/tsx --test ./src/*.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
