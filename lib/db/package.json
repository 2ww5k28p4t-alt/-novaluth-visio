{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "check-schema": "../../scripts/node_modules/.bin/tsx ./src/schema-check.ts",
    "check-schema:wiring": "bash ../../scripts/check-schema-wiring.sh",
    "check-schema:isolated": "bash ./scripts/check-schema-isolated.sh",
    "test": "../../scripts/node_modules/.bin/tsx --test ./src/*.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
